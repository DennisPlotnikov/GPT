        </mxCell>
        <mxCell id="cost-value" value="4. Выставить стоимость" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="835" width="460" height="95" />
        </mxCell>
        <mxCell id="cost-check" value="5. Проверить расчёты" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="980" width="460" height="95" />
        </mxCell>
        <mxCell id="eng-materials" value="1. Собрать материалы" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="400" width="460" height="95" />
        </mxCell>
        <mxCell id="eng-depts" value="2. Направить запросы&#10;в смежные подразделения" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="545" width="460" height="95" />
        </mxCell>
        <mxCell id="eng-pki" value="3. Запросить технические данные на ПКИ" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="690" width="460" height="95" />
        </mxCell>
        <mxCell id="eng-deviations" value="4. Сформировать отступления" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="835" width="460" height="95" />
        </mxCell>
        <mxCell id="eng-check" value="5. Проверить ТО, ТТ/КД¹" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="980" width="460" height="95" />
        </mxCell>
        <mxCell id="procurement" value="ЗАКУПКИ&#10;Источник цен из исходной схемы" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="525" width="250" height="55" />
        </mxCell>
        <mxCell id="HByfbKaNo-GUg5IlXrN7-3" value="1С ERP:&#10;справочник цен&#10;на ПКИ" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;shape=dataStorage;shapeInside=1;fixedSize=1;fillColor=#FFF4D7;strokeColor=#C2A35D;strokeWidth=1.5;spacing=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="600" width="230" height="110" />
        </mxCell>
        <mxCell id="cost-done" value="РАСЧЁТ ВЫПОЛНЕН&#10;Передать ответственному менеджеру&#10;на проверку и составление&#10;итоговых документов ТКП¹" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
