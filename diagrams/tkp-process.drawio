        </mxCell>
        <mxCell id="eng-done" value="РАЗРАБОТКА ВЫПОЛНЕНА&#10;Передать ТО, ТТ/КД¹&#10;ответственному менеджеру&#10;на согласование" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
