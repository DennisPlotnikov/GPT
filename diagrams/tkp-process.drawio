        <mxCell id="HByfbKaNo-GUg5IlXrN7-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B5822A;fontFamily=Arial;fontSize=16;fontColor=#B5822A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="HByfbKaNo-GUg5IlXrN7-3" target="pricing">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="detail-footer" value="Порядок пунктов воспроизводит рукописный перечень и не задаёт обязательную последовательность между подразделениями.&#10;Закупки и 1С ERP сохранены из ранее исправленной вами схемы. Связь источника цен теперь привязана к блоку проверки цен.&#10;¹ Сокращения и нечёткие надписи требуют уточнения — см. лист 03." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#65758A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1320" width="1780" height="85" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="03 Данные и уточнения" id="tkp-notes">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1510" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_title" value="Данные расчёта и вопросы для уточнения" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontSize=27;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1420" height="45" />
        </mxCell>
        <mxCell id="n_sub" value="Сохранены факты исходного калькулятора; вопросы обновлены по рукописной схеме и вашим правкам. Версия 31.10.2026." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontColor=#65758A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="82" width="1420" height="35" />
        </mxCell>
        <mxCell id="n_confirm" value="Что следует из предоставленного калькулятора" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="145" width="1420" height="35" />
        </mxCell>
        <mxCell id="c0h" value="Требования и комплектация" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="195" width="260" height="80" />
        </mxCell>
        <mxCell id="c0b" value="Используется опросный лист. В «Конфигурации» задаются ячейки, исполнения, токи, количество, опции и комплектующие на одну ячейку. Исходный опросный лист отдельно не предоставлен." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="195" width="1140" height="80" />
        </mxCell>
        <mxCell id="c1h" value="Цены и нормативы" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="290" width="260" height="80" />
        </mxCell>
        <mxCell id="c1b" value="«Справочник цен»: цены оборудования и сервиса, базовые ставки работ, коэффициенты и доплаты. В предоставленном файле цены обозначены как демонстрационные." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="290" width="1140" height="80" />
        </mxCell>
        <mxCell id="c2h" value="Последовательность расчёта" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="385" width="260" height="80" />
        </mxCell>
        <mxCell id="c2b" value="Оборудование + сборка и испытания + сервисное оборудование → прямые затраты → наценка → цена без НДС → НДС → итог." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="385" width="1140" height="80" />
        </mxCell>
        <mxCell id="c3h" value="Выходные данные и контроль" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="480" width="260" height="80" />
        </mxCell>
        <mxCell id="c3b" value="«Смета», «Свод» и «Проверка». Доставка, шеф-монтаж, ЗИП и внешние кабели исключены в текущем примере. Фактический шаблон ТКП не предоставлен." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#EAF3FD;strokeColor=#7DA4D0;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="480" width="1140" height="80" />
        </mxCell>
        <mxCell id="n_questions" value="Что нужно подтвердить при корректировке схемы" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="605" width="1420" height="35" />
        </mxCell>
        <mxCell id="q0h" value="01 · Участники" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="655" width="690" height="36" />
        </mxCell>
        <mxCell id="q0b" value="Менеджер принимает запрос и формирует заявку в Битрикс; получает результаты на проверку / согласование. Уточнить подразделения и должности исполнителей расчёта, разработки и иных согласующих." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#FFF9EA;strokeColor=#D8BC7C;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="697" width="690" height="98" />
        </mxCell>
        <mxCell id="q1h" value="02 · Начало процесса" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="655" width="690" height="36" />
        </mxCell>
        <mxCell id="q1b" value="Регистрация в Битрикс подтверждена. Уточнить назначение исполнителей, приоритетов и сроков; состав обязательных входных данных; что означает «подготовка ПГ»." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#FFF9EA;strokeColor=#D8BC7C;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="697" width="690" height="98" />
        </mxCell>
        <mxCell id="q2h" value="03 · Техническая проработка" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="815" width="690" height="36" />
        </mxCell>
        <mxCell id="q2b" value="Когда нужны расчёт и/или разработка? Чем различаются ТО/КД в запросе и ТО, ТТ/КД в результате? Кто утверждает отступления и комплектность технических документов?" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#FFF9EA;strokeColor=#D8BC7C;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="857" width="690" height="98" />
        </mxCell>
        <mxCell id="q3h" value="04 · Цены и поставщики" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="815" width="690" height="36" />
        </mxCell>
        <mxCell id="q3b" value="Источник цен на ПКИ — 1С ERP (ваша правка). Уточнить владельца справочника, связь с расчётным ПО, обновление цен, сроки поставки, валюты, скидки и срок действия предложений." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#FFF9EA;strokeColor=#D8BC7C;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="857" width="690" height="98" />
        </mxCell>
        <mxCell id="q4h" value="05 · Согласование" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="975" width="690" height="36" />
        </mxCell>
        <mxCell id="q4b" value="Проверка расчёта и согласование документов ответственным менеджером подтверждены сканом. Дополнительные согласования цены, наценки, сроков и условий; полномочия и порядок выпуска ТКП пока не подтверждены." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#FFF9EA;strokeColor=#D8BC7C;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1017" width="690" height="98" />
        </mxCell>
        <mxCell id="q5h" value="06 · Выпуск и сроки" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="975" width="690" height="36" />
        </mxCell>
        <mxCell id="q5b" value="В скане нет финальной отправки заказчику: она сохранена из прежней схемы пунктиром. Уточнить шаблон и место хранения ТКП, версии, отправителя, длительности работ и ожиданий." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#203047;strokeColor=#A9B8C8;strokeWidth=1.3;fillColor=#FFFFFF;spacing=10;fillColor=#FFF9EA;strokeColor=#D8BC7C;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="1017" width="690" height="98" />
        </mxCell>
        <mxCell id="n_footer" value="Границы процесса: от запроса заказчика до отправки ТКП (выпуск — по исходной схеме, требует подтверждения).&#10;Скан использован как источник фактов о процессе. Переписка, адреса и изображение вложения в публичный файл не включены." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontColor=#203047;fontSize=15;fontColor=#65758A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1400" width="1420" height="70" />
        </mxCell>
        <mxCell id="ambiguities-title" value="Неоднозначные надписи в скане — сохранены без расшифровки" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#23364D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1150" width="1420" height="40" />
        </mxCell>
        <mxCell id="ambiguities" value="«ПГ» — подготовка в блоке менеджера. «ПО БМЗ» — название расчётного ПО читается предположительно.&#10;«Щит» — подпись после «расчёт оборудования»; назначение уточнить. ТО, ТТ/КД — обозначения документации как в скане.&#10;На стрелке возврата расчёта: «итоговой РК и КП» (первое сокращение неразборчиво). На листах 01–02 использовано общее «итоговые документы ТКП».&#10;Ромб переформулирован как «Данных достаточно?»: Нет → запрос уточнений, Да → выполнение необходимых работ." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#FFF4D7;strokeColor=#C2A35D;align=left;fontSize=17;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1200" width="1420" height="160" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="04 Как будет — себестоимость" id="tkp-tobe-cost">
    <mxGraphModel dx="2160" dy="1690" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1690" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Как будет: расчёт себестоимости с помощью ИИ" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=#23364D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="25" width="2060" height="50" />
        </mxCell>
        <mxCell id="sub" value="Проект целевого процесса • 31.10.2026 • Ветка разработки ТО/КД здесь не рассматривается • Источники и правила — лист 05" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#65758A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="85" width="2060" height="44" />
        </mxCell>
        <mxCell id="phase1" value="01  Подготовить и подтвердить состав заказа" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontColor=#23364D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="145" width="1800" height="40" />
        </mxCell>
        <mxCell id="job" value="1. МЕНЕДЖЕР&#10;Запустить задание в Битрикс:&#10;ОЛ / ТЗ, количество ячеек,&#10;границы поставки и дата оценки" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="230" width="440" height="120" />
        </mxCell>
        <mxCell id="extract" value="2. ИИ&#10;Извлечь позиции и требования&#10;из ОЛ / ТЗ / приложений;&#10;показать ссылки на исходные фрагменты" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#F0E9FA;strokeColor=#9676BA;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="230" width="440" height="120" />
        </mxCell>
        <mxCell id="input-ready" value="Обязательные&#10;входные данные&#10;полны?" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rhombus;spacing=8;strokeWidth=1.5;fillColor=#FFF4D7;strokeColor=#C2A35D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="225" width="230" height="130" />
        </mxCell>
        <mxCell id="clarify" value="МЕНЕДЖЕР / ТЕХСПЕЦИАЛИСТ&#10;Получить недостающие данные&#10;и исправить неоднозначности" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1660" y="240" width="400" height="100" />
        </mxCell>
        <mxCell id="match" value="3. ИИ + ПРАВИЛА&#10;Сопоставить с номенклатурой 1С;&#10;подготовить состав и количества;&#10;выделить дубли и возможные аналоги" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#F0E9FA;strokeColor=#9676BA;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1135" y="430" width="440" height="120" />
        </mxCell>
        <mxCell id="approve-bom" value="4. ТЕХНИЧЕСКИЙ СПЕЦИАЛИСТ&#10;Подтвердить состав, количество&#10;и допустимые замены;&#10;зафиксировать версию спецификации" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="430" width="440" height="120" />
        </mxCell>
        <mxCell id="internal" value="5. СИСТЕМА&#10;Собрать внутренние цены, нормы&#10;и доступные расчётные данные&#10;из 1С ERP / ПО БМЗ¹" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="430" width="440" height="120" />
        </mxCell>
        <mxCell id="phase2" value="02  Подобрать цены и закрыть пробелы" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontColor=#23364D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="590" width="1800" height="40" />
        </mxCell>
        <mxCell id="internal-ready" value="Внутренних цен&#10;и норм достаточно?&#10;Они применимы&#10;и актуальны?" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rhombus;spacing=8;strokeWidth=1.5;fillColor=#FFF4D7;strokeColor=#C2A35D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="205" y="680" width="230" height="140" />
        </mxCell>
        <mxCell id="external" value="6. ИИ / ОТВЕТСТВЕННЫЙ&#10;По пробелам: найти предложения ПКИ&#10;у производителей / поставщиков.&#10;Нормы и прочие данные — запросить&#10;у ответственных подразделений." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#F0E9FA;strokeColor=#9676BA;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="900" width="440" height="140" />
        </mxCell>
        <mxCell id="normalize" value="7. ИИ + ПРАВИЛА&#10;Привести к единому виду:&#10;артикулы, единицы, количества,&#10;валюта, НДС, доставка, даты.&#10;Зафиксировать источник каждой позиции." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#F0E9FA;strokeColor=#9676BA;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="900" width="440" height="140" />
        </mxCell>
        <mxCell id="approve-inputs" value="8. ЗАКУПКИ / ТЕХСПЕЦИАЛИСТ&#10;Рассмотреть пробелы и конфликты;&#10;подтвердить выбранные цены, нормы&#10;и согласование аналогов.&#10;Веб-цена до проверки — кандидат." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1135" y="900" width="440" height="140" />
        </mxCell>
        <mxCell id="approved" value="Все обязательные&#10;данные подтверждены&#10;и противоречия&#10;устранены?" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rhombus;spacing=8;strokeWidth=1.5;fillColor=#FFF4D7;strokeColor=#C2A35D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="1130" width="250" height="140" />
        </mxCell>
        <mxCell id="resolve" value="ОТВЕТСТВЕННЫЙ&#10;Уточнить позицию / норму;&#10;получить КП поставщика.&#10;Незакрытые данные сохраняют&#10;статус «Расчёт не завершён»." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;fillColor=#FFF4D7;strokeColor=#C2A35D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1680" y="1140" width="400" height="130" />
        </mxCell>
        <mxCell id="price-rule" value="ПРАВИЛО ВЫБОРА ИСТОЧНИКА&#10;Пригодность для данного заказа важнее&#10;формального приоритета системы.&#10;Сравнить артикул, условия, дату&#10;и статус подтверждения; не брать&#10;минимальную цену автоматически." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#FFF4D7;strokeColor=#C2A35D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="680" width="440" height="150" />
        </mxCell>
        <mxCell id="pki-note" value="Поиск в интернете запускается для отсутствующих&#10;или устаревших цен ПКИ. Сохраняются страница / КП,&#10;дата получения и условия предложения.&#10;Изменение состава возвращает к шагам 3–4." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#65758A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1135" y="685" width="920" height="135" />
        </mxCell>
        <mxCell id="phase3" value="03  Рассчитать, проверить и передать результат" style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontColor=#23364D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1310" width="1800" height="40" />
        </mxCell>
        <mxCell id="calculate" value="9. РАСЧЁТНЫЙ МОДУЛЬ&#10;Один утверждённый исполнитель¹:&#10;количество × цена, нормы × ставки,&#10;предусмотренные методикой расходы.&#10;Проверка полноты и двойного учёта." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1135" y="1400" width="440" height="140" />
        </mxCell>
        <mxCell id="review" value="10. ПРОВЕРКА РАСЧЁТА&#10;ИИ объясняет отклонения и источники.&#10;Ответственный проверяет расшифровку,&#10;возвращает замечания к данным / методике&#10;и утверждает итог." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="1400" width="440" height="140" />
        </mxCell>
        <mxCell id="result" value="11. РЕЗУЛЬТАТ МЕНЕДЖЕРУ&#10;Себестоимость по ячейкам и заказу;&#10;расшифровка, источники и допущения;&#10;версии входов, формул и утверждения.&#10;Далее — формирование цены и ТКП." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;rounded=1;arcSize=12;strokeWidth=1.5;spacing=14;fillColor=#EAF3FD;strokeColor=#7DA4D0;fillColor=#EAF5ED;strokeColor=#83A889;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1400" width="440" height="140" />
        </mxCell>
        <mxCell id="legend" value="Фиолетовый — помощь ИИ; синий — загрузка данных и точный расчёт по правилам; зелёный — решения сотрудников.&#10;¹ Назначение, доступные данные и способ обмена ПО БМЗ уточняются. Владельца итогового расчёта выбрать до интеграции.&#10;Наценка и формирование отпускной цены — следующий этап. Неподтверждённые обязательные цены не заменяются нулём." style="fontFamily=Arial;fontColor=#23364D;fontSize=18;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#65758A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1590" width="2040" height="75" />
        </mxCell>
        <mxCell id="f01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="job" target="extract">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f02" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="extract" target="input-ready">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f03" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B5822A;fontFamily=Arial;fontSize=16;fontColor=#B5822A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="input-ready" target="clarify">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f04" value="Уточнённые входные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B5822A;fontFamily=Arial;fontSize=16;fontColor=#B5822A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="clarify" target="extract">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1860" y="195" />
              <mxPoint x="870" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f05" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input-ready" target="match">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f06" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="match" target="approve-bom">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f07" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="approve-bom" target="internal">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f08" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="internal" target="internal-ready">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f09" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="internal-ready" target="external">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="f10" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="internal-ready" target="normalize">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="570" y="750" />
              <mxPoint x="570" y="970" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526B88;fontFamily=Arial;fontSize=16;fontColor=#526B88;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="external" target="normalize">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
